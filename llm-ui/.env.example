# Copy to .env.local (auto-ignored by git via root .gitignore .env* rule).
# Phase 3 will add a paste-in dev banner; until then auth-token.ts reads these.

# WebSocket base URL for the chat-v2 server (no trailing /ws/chat/v2 — appended at runtime).
VITE_WS_URL=ws://localhost:3000

# Dev-only JWT. Mint via:
#   curl -sS -X POST http://localhost:3000/auth/login \
#     -H 'Content-Type: application/json' \
#     -d '{"username":"demo","password":"admin123456"}' | jq -r .token
VITE_DEV_JWT=
