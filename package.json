{
  "name": "ai-connect",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev:http": "pnpm --filter llm-http dev",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @ai-connect/db db:generate",
    "db:migrate": "pnpm --filter @ai-connect/db db:migrate",
    "db:studio": "pnpm --filter @ai-connect/db db:studio"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.23.0"
}
