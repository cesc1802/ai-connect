# Copy to .env for local development. Do not commit real secrets.

# Database
DATABASE_URL=postgres://ai_connect:ai_connect_dev@localhost:5432/ai_connect
DATABASE_POOL_MAX=10

# Override the host port if 5432 is already in use locally.
# POSTGRES_PORT=5433

# Persistence backend for conversation/message repos: "in-memory" (default) or "drizzle".
# PERSISTENCE=drizzle
#
# When PERSISTENCE=drizzle, conversations.user_id is a real FK to users.id. The dev
# chat flow uses the seeded dev user, so it works out of the box. But if you log in
# via DEMO_USERS, that user's id MUST exist in the database (e.g. pin its id to the
# seeded dev user id) or the first conversation insert fails the FK constraint.
# A database-backed user repository is a future change; until then, keep DEMO_USERS
# ids aligned with seeded rows when running against Postgres.
