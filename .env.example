# Copy to .env for local development. Do not commit real secrets.

# Database
DATABASE_URL=postgres://ai_connect:ai_connect_dev@localhost:5432/ai_connect
DATABASE_POOL_MAX=10

# Override the host port if 5432 is already in use locally.
# POSTGRES_PORT=5433

# Conversations/messages are stored in Postgres. conversations.user_id is a real
# FK to users.id, so users logged in via DEMO_USERS must exist in the database
# (keep DEMO_USERS ids aligned with seeded rows).
