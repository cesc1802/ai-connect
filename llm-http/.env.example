NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Frontend origins allowed to call this API (CORS). Comma-separated for multiple.
CORS_ORIGIN=http://localhost:5173

# LLM providers are configured in the database (org admin API), not env vars.
# PROVIDER_KEY_VAULT_KEY encrypts stored provider API keys (32-byte hex).
# Generate: openssl rand -hex 32
PROVIDER_KEY_VAULT_KEY=
# How long the gateway serves the last loaded provider set before re-checking the DB.
# The gateway enforces a 1000ms minimum; lower values are raised to it.
PROVIDER_REFRESH_TTL_MS=60000

# Auth (REQUIRED - min 32 chars for JWT_SECRET)
# Generate JWT_SECRET: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=1h

# Demo users JSON array (generate hash with: pnpm tsx scripts/hash-password.ts <password>)
# Example: [{"id":"user-1","username":"demo","passwordHash":"$2a$10$..."}]
DEMO_USERS=[]
